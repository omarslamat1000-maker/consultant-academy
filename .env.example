# ============================================================
# أكاديمية المستشار — متغيرات البيئة (نموذج بلا أسرار)
# انسخ هذا الملف إلى .env محليًا (مستبعد من Git) أو أدخل القيم في Netlify > Site settings > Environment variables
# لا تضع أي مفتاح حقيقي في هذا الملف أو في أي ملف داخل المستودع
# ============================================================

# ---------- الواجهة (تُضمَّن في حزمة المتصفح — مفاتيح قابلة للنشر فقط) ----------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# المفتاح القابل للنشر (anon / sb_publishable_...) فقط — تحكمه سياسات RLS
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# ---------- الخادم (Netlify Functions فقط — لا تصل إلى المتصفح أبدًا) ----------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# مفتاح service_role: خادمي فقط. لا يُستخدم في الواجهة إطلاقًا
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# مفتاح التشفير الرئيس لتخزين مفاتيح مزودي الذكاء الاصطناعي (AES-256-GCM)
# أنشئه بالأمر: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# بدون هذا المتغير لا يمكن حفظ مفاتيح المزودين من داخل التطبيق
CONFIG_ENCRYPTION_KEY=BASE64-32-BYTES

# (اختياري) مفتاح Gemini كبديل عند عدم ربط مزود من لوحة الإدارة — خادمي فقط
GEMINI_API_KEY=
# (اختياري) النموذج الافتراضي عند استخدام المتغير أعلاه
GEMINI_MODEL=gemini-2.5-flash

# (اختياري) الأصل المسموح لطلبات API (CORS). افتراضيًا نفس الأصل
ALLOWED_ORIGIN=

# (محلي فقط) منفذ خادم API التطويري الذي يحاكي Netlify Functions
DEV_API_PORT=8788

# (اختياري) اسم موقع Netlify لبناء روابط مباشرة في صفحة مفتاح API
VITE_NETLIFY_SITE_NAME=

# بديل عن service_role: سر القناة الخدمية (الترحيل 0007) — خادمي فقط
FUNCTIONS_SERVICE_SECRET=
