{
  "name": "consultant-academy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "أكاديمية المستشار — منصة عربية ذكية لتطوير مهارات حل المشكلات والحالات الاستشارية",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch tools/dev-api.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.functions.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:secrets": "node tools/check-secrets.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "dev:demo": "vite --mode demo --port 8221",
    "doctor": "node tools/check-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@netlify/functions": "^6.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
